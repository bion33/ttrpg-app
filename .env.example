# Client (Vite) environment. Copy to `.env` for local development.
# These values are PUBLIC by design — the client id and redirect URI are safe to ship
# to the browser. The client SECRET stays server-side only (see server/.env.example).

# Microsoft OAuth (OneDrive). From the Entra ID app registration's Overview (see the README Storage section).
VITE_MS_CLIENT_ID=
VITE_MS_TENANT=common
VITE_MS_REDIRECT_URI=http://localhost:8080/oauth/microsoft/callback.html

# Google OAuth (Google Drive). From the Google Cloud Console OAuth client (see the README Storage section).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback.html
