PORT=3000
APP_ORIGIN=http://localhost:8080

# Comma-separated Nextcloud instance hostnames the relay may forward to (SSRF allowlist).
# Required in production: when unset there, the relay refuses every forward (503, fail closed).
# In development it may be left unset to reach a local/http Nextcloud.
NEXTCLOUD_ALLOWED_HOSTS=

# Microsoft OAuth (OneDrive). Register an app in Entra ID (see the phase-4 setup notes in the README).
MS_TENANT=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8080/oauth/microsoft/callback.html

# Google OAuth (Google Drive). Create OAuth client credentials in Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback.html
